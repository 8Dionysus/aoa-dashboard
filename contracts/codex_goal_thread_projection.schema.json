{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aoa-dashboard://contracts/codex-goal-thread-projection-v1",
  "title": "Bounded Codex Goal and Thread observation",
  "type": "object",
  "required": ["schema_version", "owner_schema_version", "state", "currentness", "observed_at", "goal_ref", "goal_projection", "thread", "relations", "diagnostics", "claim_limit"],
  "properties": {
    "schema_version": {"const": "aoa_dashboard_codex_goal_thread_observation_v1"},
    "owner_schema_version": {"const": "codex_goal_thread_observation_v1"},
    "state": {"enum": ["bound", "missing", "unknown", "stale", "deferred", "invalid"]},
    "currentness": {"type": "string"},
    "observed_at": {"type": ["string", "null"]},
    "goal_ref": {"type": "object", "required": ["thread_id", "owner"], "properties": {"thread_id": {"type": ["string", "null"]}, "owner": {"const": "codex-app-server"}, "source": {"type": ["string", "null"]}}, "additionalProperties": true},
    "goal_projection": {"type": "object"},
    "thread": {"$ref": "#/$defs/observation"},
    "relations": {"type": "object", "required": ["spawn_parent", "history_fork"], "properties": {"spawn_parent": {"$ref": "#/$defs/relation"}, "history_fork": {"$ref": "#/$defs/relation"}}, "additionalProperties": false},
    "sources": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "observation": {
      "type": "object",
      "required": ["state", "currentness", "thread_id", "evidence_refs", "diagnostics", "claim_limit"],
      "properties": {
        "state": {"enum": ["bound", "missing", "unknown", "stale", "deferred", "invalid"]},
        "currentness": {"type": "string"},
        "thread_id": {"type": ["string", "null"]},
        "thread": {"type": ["object", "null"]},
        "source": {"type": ["object", "null"]},
        "evidence_refs": {"type": "array"},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "claim_limit": {"type": "string"}
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["state", "relation_kind", "query_kind", "anchor_thread_id", "items", "complete_for_query", "evidence_refs", "diagnostics", "claim_limit"],
      "properties": {
        "state": {"enum": ["bound", "missing", "unknown", "stale", "deferred", "invalid"]},
        "relation_kind": {"enum": ["spawn_parent", "history_fork"]},
        "query_kind": {"enum": ["parentThreadId", "ancestorThreadId"]},
        "anchor_thread_id": {"type": "string", "minLength": 1},
        "items": {"type": "array", "items": {"type": "object"}},
        "complete_for_query": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array"},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "claim_limit": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
