{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aoa-dashboard://contracts/action-intent-v1",
  "title": "Dashboard-owned non-executing action intent",
  "type": "object",
  "required": ["schema_version", "intent_id", "created_at", "requested_by", "target_ref", "owner_route", "summary", "state", "effect", "authority"],
  "properties": {
    "schema_version": {"const": "aoa_dashboard_action_intent_v1"},
    "intent_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "requested_by": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "minLength": 1},
    "owner_route": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "state": {"const": "deferred"},
    "effect": {"const": "none"},
    "authority": {"const": "dashboard_owned"}
  },
  "additionalProperties": false
}
