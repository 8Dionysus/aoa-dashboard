{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aoa-dashboard://contracts/goal-space-projection-v1",
  "title": "aoa-dashboard derived Goal Space projection",
  "type": "object",
  "required": ["schema_version", "generated_at", "goal", "goal_context", "owner_goal_context", "master_context", "participant_context", "goal_catalog", "correlation", "actor_activity", "correlation_read_model", "pressure_inbox", "current_holder", "dag", "branches", "trajectories", "lifecycle", "state_inventory", "sources", "owner_surfaces", "claim_limits"],
  "properties": {
    "schema_version": {"const": "aoa_dashboard_projection_v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "presentation": {"type": "object"},
    "goal": {"type": "object"},
    "goal_context": {"$ref": "aoa-dashboard://contracts/goal-context-projection-v1"},
    "owner_goal_context": {"$ref": "aoa-dashboard://contracts/codex-goal-thread-projection-v1"},
    "master_context": {"$ref": "aoa-dashboard://contracts/master-context-projection-v1"},
    "goal_topology": {"$ref": "aoa-dashboard://contracts/goal-topology-projection-v1"},
    "participant_context": {"$ref": "aoa-dashboard://contracts/participant-context-v1"},
    "goal_catalog": {"$ref": "aoa-dashboard://contracts/goal-catalog-projection-v1"},
    "correlation": {"$ref": "aoa-dashboard://contracts/correlation-envelope-v1#/$defs/projection"},
    "correlation_read_model": {"$ref": "aoa-dashboard://contracts/goal-local-correlation-projection-v1"},
    "pressure_inbox": {"$ref": "aoa-dashboard://contracts/pressure-inbox-v1"},
    "actor_activity": {
      "type": "object",
      "required": ["schema_version", "state", "actors", "summary", "claim_limit"],
      "properties": {
        "schema_version": {"const": "aoa_dashboard_actor_activity_v1"},
        "state": {"type": "string"},
        "actors": {"type": "array", "items": {"type": "object"}},
        "summary": {"type": "object"},
        "evidence_refs": {"type": "array"},
        "claim_limit": {"type": "string"}
      },
      "additionalProperties": true
    },
    "current_holder": {"type": "object"},
    "dag": {"type": "array"},
    "branches": {"type": "array"},
    "trajectories": {"type": "array"},
    "lifecycle": {"type": "array"},
    "state_inventory": {"type": "array"},
    "sources": {"type": "array"},
    "owner_surfaces": {"type": "array"},
    "annotations": {"type": "object"},
    "action_intents": {"type": "object"},
    "claim_limits": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
